@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="header-auth-links">
                <a href="javascript:void(0)" @onclick='() => TriggerSwitchForm("login")' class="header-link">Đăng nhập</a>
                <span class="header-divider">|</span>
                <a href="javascript:void(0)" @onclick='() => TriggerSwitchForm("register")' class="header-link">Đăng ký</a>
            </div>
        </div>

        <article class="content">
            <CascadingValue Value="this">
                @Body
            </CascadingValue>
        </article>
    </main>
</div>

@code {
    public event Action<string>? OnSwitchFormRequested;

    private void TriggerSwitchForm(string formName)
    {
        OnSwitchFormRequested?.Invoke(formName);
    }
}

<style>
    .sidebar {
        display: none !important;
    }

    .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-left: 0 !important;
    }

    .top-row {
        height: 56px;
        background-color: #ffffff !important;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding: 0 30px !important;
        z-index: 10;
    }

    .header-auth-links {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-link {
        color: #3182ce !important;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 14px;
        transition: color 0.2s;
        cursor: pointer;
    }

        .header-link:hover {
            color: #2b6cb0 !important;
            text-decoration: underline !important;
        }

    .header-divider {
        color: #e2e8f0;
        font-size: 14px;
    }

    .content {
        flex: 1;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
    }
</style>